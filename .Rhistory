painel_f <- df_wide_f %>%
pivot_longer(
cols = c(estab_2000, hab_2000, renda_2000,
estab_2010, hab_2010, renda_2010),
names_to = c("var", "ano"),
names_pattern = "(estab|hab|renda)_(2000|2010)",
values_to = "valor"
) %>%
pivot_wider(names_from = var, values_from = valor) %>%
mutate(
ano = as.integer(ano),
estab_por_10mil = (estab / hab) * 10000,
ln_renda = log(renda)
) %>%
filter(is.finite(ln_renda), is.finite(estab_por_10mil))
# 4) Rodar os 3 modelos na amostra filtrada
m_renda_pc <- feols(ln_renda ~ estab_por_10mil | bairro + ano,
data = painel_f, cluster = ~bairro)
m_renda_abs <- feols(ln_renda ~ estab | bairro + ano,
data = painel_f, cluster = ~bairro)
m_renda_abs_pop <- feols(renda ~ estab + hab | bairro + ano,
data = painel_f, cluster = ~bairro)
# 5) Mostrar quantos bairros/obs sobraram
cat("Limiar hab_min >=", LIMIAR_HAB, "\n")
cat("Bairros:", n_distinct(painel_f$bairro), "\n")
cat("Observações:", nrow(painel_f), "\n\n")
etable(
m_renda_pc, m_renda_abs, m_renda_abs_pop,
dict = c(
"estab_por_10mil" = "Noturnos por 10 mil hab.",
"estab"           = "Nº de noturnos",
"log(hab)"        = "Log(população)"
),
fitstat = ~ n + r2 + wr2,
se.below = TRUE
)
